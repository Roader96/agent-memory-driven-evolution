<?xml version="1.0" encoding="UTF-8"?>
<!--
  agent-memory-driven-evolution · launchd 调度模板
  ⚠️ 不要直接使用本文件！请运行 ./install.sh 自动生成（会替换 __HOME__ 与 __SCRIPTS_DIR__）

  模板变量:
    __HOME__       当前用户主目录
    __SCRIPTS_DIR__ 脚本安装目录（默认 ~/.hermes/scripts）
    __PYTHON_BIN__  python3 可执行文件
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roader.skill-evolution-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>__SCRIPTS_DIR__/skill_evolution/run_weekly.py</string>
    </array>
    <!-- 每周日 21:30 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>21</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key>
    <string>__HOME__/.hermes/logs/skill_evolution.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.hermes/logs/skill_evolution.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>__HOME__</string>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>